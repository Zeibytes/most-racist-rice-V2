//-*- mode: jsonc -*-
{
    "layer": "top", 
    "position": "top", 
    "height": 20, 
    "spacing": 4, 

    // Choose the order of the modules
    "modules-left": [
        "ext/workspaces",
        "custom/sep",
        "mpris"
    ],
    "modules-center": [
    ],

    "modules-right": [
        "custom/cpucat",
        "custom/sep",
        "wireplumber",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "disk",
        "custom/sep",
        "clock",
        "custom/sep",
        "tray"
    ],

    // Modules configuration
    "ext/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "persistent-workspaces": {
            "*" : 9
        }
    },
    "custom/cpucat": {
        "exec":"~/.config/waybar/scripts/catloop.sh"
  },
    "ext/window" : {
        "max-length": 40,
        "seperate-outputs": false
    },
    "mpris": {
        "format": " {artist} - {title}",
        "format-paused": "󰐊 {artist} - {title}",
        "max-length": 45,
        "tooltip": true,
        "player": "spotify"
    },
    "wireplumber": {
        "format": "Vol: {volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol"
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "Ram: {used}GiB"
    },
    "disk": {
        "interval": 1,
        "path": "/",
        "format": "Disk: {free}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "Bat: {capacity}% {icon} {time}",
        "format-plugged": "{capacity}% ",
        "format-alt": "Bat {capacity}%",
        "format-time": "{H}:{M}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format": "Connected",
        "format-disconnected": "Disconnected ⚠"
    },
    "custom/sep": {
        "format" : "|",
        "interval" : 0
    }
}
